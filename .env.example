# Create a free key at https://www.alphavantage.co/support/#api-key
# Leave unset to use clearly labeled simulated data.
ALPHA_VANTAGE_API_KEY=
# Optional: set this to your live HTTPS domain for canonical URLs and sitemap.
# Vercel deployments use the built-in VERCEL_URL when this is unset.
NEXT_PUBLIC_SITE_URL=
# Supabase Auth (Google OAuth + email/password)
# Copy these from your Supabase project settings; the publishable key is safe in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
